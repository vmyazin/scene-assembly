# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.codebase-memory/
/.worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local auth database (never committed; lives beside the app on the server)
/data/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# playwright — driving the running app drops screenshots and snapshots here
.playwright*/

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers — brainstorming mockups and subagent-execution ledger
.superpowers/

# Local Cloudflare state and credentials
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

test-assets/*