{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scene-assembly-accounts",
  // Pin Rapid Systems so an unrelated active Wrangler account cannot receive a deploy.
  "account_id": "7f64edc36bdefec27b66e6ff9b2dcc3d",
  "main": "src/entry.ts",
  // Pinned with Wrangler 4.113: later local proxies currently crash on connection loss.
  "compatibility_date": "2026-07-20",
  "define": { "__LOCAL_DEV__": "false" },
  // PiAPI uses manual redirect handling for Workers; error mode throws before fetch.
  // Hosted-reference verification and deployment results are recorded in its plan.
  // The providers offered background generation. Live tab-close/autosave status per
  // provider is tracked in docs/superpowers/plans/2026-09-05-cloud-provider-enablement.md;
  // Gemini and PiAPI reference checks passed; other checks remain pending. Removing a name does not
  // stop work already accepted by that vendor; it only refuses new jobs and hides the
  // provider from the session response, so the workspace falls back to browser-only
  // generation rather than failing at submit.
  "vars": { "CLOUD_GENERATION_PROVIDERS": "fal,kie,runware,atlas,comet,gemini,cloudflare,pollinations,piapi", "APP_ORIGIN": "https://sceneassembly.mzork.com", "PUBLIC_WORKER_ORIGIN": "https://scene-assembly-accounts.vasily-or-simon-account.workers.dev", "MCP_ORIGIN": "https://mcp-sceneassembly.mzork.com" },
  // Keep the existing local D1 identity stable; this preview ID is local-only, not a remote preview database.
  "d1_databases": [{ "binding": "DB", "database_name": "scene-assembly-accounts", "database_id": "a5146fdd-41c6-47d3-adff-8c7aeddc3071", "preview_database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "scene-assembly-assets" }],
  // OAuth clients, grants and tokens for connected agents (workers-oauth-provider).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "8d853a0cfbe34ea3af1319e3714719a5" }],
  // Inline previews for the agents' view_asset tool. Local by default in Wrangler 4.
  "images": { "binding": "IMAGES" },
  "workflows": [{ "binding": "GENERATION", "name": "scene-assembly-generation", "class_name": "GenerationWorkflow" }],
  // File capabilities live in URL paths. Do not retain request URLs in invocation logs.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "triggers": { "crons": ["*/5 * * * *"] },
  // The MCP server's own hostname, a Workers custom domain (one level under mzork.com, so
  // the zone's Universal SSL certificate covers it).
  "routes": [{ "pattern": "mcp-sceneassembly.mzork.com", "custom_domain": true }],
  // Stays on: media links (PUBLIC_WORKER_ORIGIN) and the app gateway use the workers.dev hostname.
  "workers_dev": true
}
